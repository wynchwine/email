# Klaviyo Private API Key
# Получить здесь: https://www.klaviyo.com/account#api-keys-tab
# Формат: pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KLAVIYO_API_KEY=pk_your_klaviyo_api_key_here

# Klaviyo List ID для формы сбора email на лендинге (public/index.html → /api/subscribe)
# Найти: Klaviyo → Lists & Segments → открыть список → ID в URL / настройках
# Если не задан — email просто добавляется в профиль без подписки на список.
KLAVIYO_NEWSLETTER_LIST_ID=

# Klaviyo метрика для конверсий в отчёте по флоу (/api/flows). Обычно "Placed Order".
# Нужна, потому что Klaviyo Reporting API требует conversion_metric_id.
# Задай явно, если у API-ключа нет доступа к чтению метрик (Analytics) — тогда
# авто-определение отключается и берётся этот ID.
# Найти ID: Klaviyo → Metrics → открыть метрику → ID в URL.
KLAVIYO_CONVERSION_METRIC_ID=

# Anthropic API Key (Claude)
# Получить здесь: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Shopify store domain (without https://)
# Пример: your-store.myshopify.com
SHOPIFY_SHOP=your-store.myshopify.com

# Shopify Admin API access token (РЕКОМЕНДУЕТСЯ для custom app).
# Shopify admin → Settings → Apps and sales channels → Develop apps → ваш app →
# API credentials → Admin API access token (формат shpat_...).
# Если задан — используется напрямую (client_credentials ниже игнорируется).
SHOPIFY_ACCESS_TOKEN=shpat_your_admin_api_token_here

# Shopify Dev Dashboard Client ID и Secret (запасной путь, если нет SHOPIFY_ACCESS_TOKEN)
# Получить в Shopify Dev Dashboard → твой app → Settings → Credentials
# Токен запрашивается автоматически через client_credentials grant (живёт 24 часа)
# ВАЖНО: для создания аккаунтов покупателей (/api/register) приложению нужен
# scope write_customers (иначе Shopify вернёт 403).
SHOPIFY_CLIENT_ID=your_client_id_here
SHOPIFY_CLIENT_SECRET=shpss_your_client_secret_here

# Shopify Webhook Secret (HMAC verification)
# Получить в Shopify Admin → Settings → Notifications → Webhooks
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret_here

# Токен доступа к дашборду (/dashboard.html → /api/stats).
# Любая длинная случайная строка. Держи в секрете — открывает email/имена клиентов.
# Открывать дашборд: https://<vercel-домен>/dashboard.html  (ввести токен)
DASHBOARD_TOKEN=your_long_random_secret_here
