{% comment %}
  WYNCH — blog article template (alternate).
  Renders a single blog article in the WYNCH design system. It is an
  ALTERNATE template ("article.wynch"), so it does not replace the theme's
  default article template — assign it per article in the editor.
  All styles are scoped under .wynch-article to avoid clashing with the theme.
{% endcomment %}

<link rel="preconnect" href="https://wynch.wine" crossorigin>
<style>
  @font-face {
    font-family: "Giorgio Sans Medium";
    src: url("https://wynch.wine/cdn/shop/t/22/assets/giorgio-sans-medium.static.woff2?v=132781297963084722121782491269") format("woff2");
    font-weight: 400 700; font-style: normal; font-display: swap;
  }
  @font-face {
    font-family: "Aktiv Grotesk Regular";
    src: url("https://wynch.wine/cdn/shop/t/22/assets/aktiv-grotesk-regular.static.woff2?v=138786277528983394311782491269") format("woff2");
    font-weight: 400; font-style: normal; font-display: swap;
  }

  .wynch-article {
    --accent: #ff6315;
    --bg: #eeece7;
    --text: #5d5e60;
    --ink: #3f3f41;
    --muted: #999999;
    --line: #e2ded6;
    --font-head: "Giorgio Sans Medium", "Futura", "Century Gothic", "Helvetica Neue", Arial, sans-serif;
    --font-body: "Aktiv Grotesk Regular", "Helvetica Neue", Arial, sans-serif;
    background: var(--bg);
    font-family: var(--font-body);
    color: var(--text);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    /* Side inset must match the theme's header/footer frame so the vertical
       lines line up. Tweak --wa-inset if your theme uses a different margin. */
    --wa-inset: 4vw; /* mobile: matches theme .with-h-paddings */
    padding: 0 var(--wa-inset); /* no top/bottom gap — frame meets header/footer */
  }
  .wynch-article * { box-sizing: border-box; }
  /* Desktop: match the theme's .with-h-paddings @media (min-width:768px) exactly */
  @media (min-width: 768px) {
    .wynch-article { --wa-inset: calc(min(100vw, 1440px) * 20 / 1440); }
  }
  /* Orange editorial frame around the content, like the header/footer */
  .wa-frame { border: 1px solid var(--accent); padding: 48px 30px 64px; }
  @media (max-width: 560px) { .wa-frame { padding: 34px 18px 44px; } }
  .wa-wrap { max-width: 760px; margin: 0 auto; }

  /* Back link */
  .wa-back {
    display: inline-block; margin-bottom: 26px;
    font-size: 13px; letter-spacing: 2px; text-transform: uppercase;
    color: var(--muted); text-decoration: none;
  }
  .wa-back:hover { color: var(--accent); }
  .wa-back span { color: var(--accent); }

  /* Title + meta */
  .wa-title {
    font-family: var(--font-head); font-weight: 700;
    color: var(--accent); text-transform: uppercase;
    font-size: clamp(38px, 6vw, 60px); line-height: 1.02; letter-spacing: -0.5px;
    margin: 0 0 16px;
  }
  .wa-meta {
    font-size: 14px; color: var(--muted); text-transform: uppercase; letter-spacing: 1px;
    margin-bottom: 30px;
  }
  .wa-meta strong { color: var(--ink); font-weight: 400; }

  /* Featured image */
  .wa-hero-img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; border-radius: 22px; margin: 0 0 40px; }

  /* Rich text content */
  .wa-rte { font-size: 18px; color: var(--ink); }
  .wa-rte > * + * { margin-top: 22px; }
  .wa-rte h2, .wa-rte h3, .wa-rte h4 {
    font-family: var(--font-head); color: var(--accent); text-transform: uppercase;
    line-height: 1.1; margin-top: 42px;
  }
  .wa-rte h2 { font-size: clamp(28px, 4vw, 38px); }
  .wa-rte h3 { font-size: clamp(24px, 3.4vw, 30px); }
  .wa-rte p { margin: 0; }
  .wa-rte a { color: var(--accent); text-decoration: underline; }
  .wa-rte img { max-width: 100%; height: auto; border-radius: 16px; display: block; }
  .wa-rte ul, .wa-rte ol { padding-left: 1.3em; }
  .wa-rte li + li { margin-top: 8px; }
  .wa-rte blockquote {
    margin: 30px 0; padding: 6px 0 6px 24px;
    border-left: 3px solid var(--accent);
    font-family: var(--font-head); font-size: clamp(22px, 3vw, 28px);
    color: var(--ink); line-height: 1.35; text-transform: none;
  }
  .wa-rte hr { border: none; border-top: 1px solid var(--line); margin: 40px 0; }
  .wa-rte code { background: rgba(0,0,0,0.05); padding: 2px 6px; border-radius: 6px; font-size: 0.9em; }

  /* Wine card (paste the snippet into the article HTML) */
  .wynch-article .wine-card {
    display: flex; gap: 22px; align-items: center;
    background: #fff; border: 1px solid var(--accent);
    border-radius: 20px; padding: 20px; margin: 34px 0;
  }
  .wynch-article .wine-card__media { flex: 0 0 130px; }
  .wynch-article .wine-card__media img { width: 130px; height: 175px; object-fit: cover; border-radius: 12px; display: block; margin: 0; }
  .wynch-article .wine-card__body { flex: 1 1 auto; min-width: 0; }
  .wynch-article .wine-card__eyebrow { font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
  .wynch-article .wine-card__title { font-family: var(--font-head); color: var(--accent); text-transform: uppercase; font-size: clamp(22px, 3vw, 28px); line-height: 1.05; margin: 0 0 8px; }
  .wynch-article .wine-card__notes { font-size: 15px; line-height: 1.5; color: var(--ink); margin: 0 0 14px; }
  .wynch-article .wine-card__foot { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .wynch-article .wine-card__price { font-family: var(--font-head); font-size: 22px; color: var(--ink); }
  .wynch-article .wine-card__btn {
    display: inline-block; text-decoration: none;
    background: var(--accent); color: #fff;
    border-radius: 9999px; padding: 12px 22px;
    font-family: var(--font-body); font-size: 14px; text-transform: uppercase; letter-spacing: 0.5px;
    transition: background 0.15s ease;
  }
  .wynch-article .wine-card__btn:hover { background: #e5570f; }
  .wynch-article .wine-card__btn { border: none; cursor: pointer; }
  .wynch-article .wine-card__btn--disabled { background: #cfcac1; cursor: default; }
  .wynch-article .wine-card__title a { color: inherit; text-decoration: none; }
  .wynch-article .wine-card form { margin: 0; }
  .wynch-article .wa-rte p:empty { display: none; }
  @media (max-width: 560px) {
    .wynch-article .wine-card { flex-direction: column; align-items: stretch; text-align: center; }
    .wynch-article .wine-card__media { align-self: center; }
    .wynch-article .wine-card__foot { justify-content: center; }
  }

  /* Tags */
  .wa-tags { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 44px; }
  .wa-tag {
    font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;
    color: var(--accent); text-decoration: none;
    border: 1px solid var(--accent); border-radius: 9999px; padding: 6px 14px;
  }
  .wa-tag:hover { background: rgba(255,99,21,0.10); }

  /* Footer CTA */
  .wa-cta {
    margin-top: 56px; padding: 34px 28px; text-align: center;
    background: #fff; border: 1px solid var(--line); border-radius: 20px;
  }
  .wa-cta h3 {
    font-family: var(--font-head); font-weight: 700; color: var(--accent);
    text-transform: uppercase; font-size: clamp(26px, 4vw, 34px); line-height: 1.05; margin: 0 0 10px;
  }
  .wa-cta p { margin: 0 0 20px; font-size: 16px; color: var(--text); }
  .wa-btn {
    display: inline-block; text-decoration: none;
    background: var(--accent); color: #fff;
    border-radius: 9999px; padding: 15px 34px;
    font-family: var(--font-body); font-size: 16px;
    text-transform: uppercase; letter-spacing: 0.5px;
    transition: background 0.15s ease;
  }
  .wa-btn:hover { background: #e5570f; }

  /* Comments */
  .wa-comments { margin-top: 56px; border-top: 1px solid var(--line); padding-top: 30px; }
  .wa-comments h3 { font-family: var(--font-head); color: var(--accent); text-transform: uppercase; font-size: 26px; margin: 0 0 20px; }
  .wa-comment { padding: 16px 0; border-bottom: 1px solid var(--line); }
  .wa-comment .who { font-size: 13px; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; margin-top: 8px; }
  .wa-form { margin-top: 26px; display: flex; flex-direction: column; gap: 12px; }
  .wa-form input, .wa-form textarea {
    font-family: var(--font-body); font-size: 16px; padding: 14px 18px;
    border: 1px solid var(--accent); border-radius: 14px; background: #fff; color: var(--ink); outline: none;
  }
  .wa-form textarea { min-height: 130px; resize: vertical; }
  .wa-form button { align-self: flex-start; border: none; cursor: pointer; }
</style>

<article class="wynch-article">
  <div class="wa-frame">
  <div class="wa-wrap">

    <a class="wa-back" href="{{ blog.url }}">&larr; <span>{{ blog.title | default: 'Blog' }}</span></a>

    <h1 class="wa-title">{{ article.title }}</h1>

    <div class="wa-meta">
      <strong>{{ article.published_at | date: '%d.%m.%Y' }}</strong>
      {% if article.author != blank %} &middot; {{ article.author }}{% endif %}
    </div>

    {% if article.image %}
      <img class="wa-hero-img"
           src="{{ article.image | image_url: width: 1600 }}"
           alt="{{ article.image.alt | default: article.title | escape }}"
           loading="eager">
    {% endif %}

    {%- comment -%}
      Inline wine cards: write [[wine:product-handle]] anywhere in the article
      body and it is replaced with a branded product card pulled from Shopify.
    {%- endcomment -%}
    {%- capture wa_body -%}{{ article.content }}{%- endcapture -%}
    {%- assign wa_chunks = wa_body | split: '[[wine:' -%}
    <div class="wa-rte">
      {{ wa_chunks.first }}
      {%- for wa_chunk in wa_chunks offset: 1 -%}
        {%- assign wine_handle = wa_chunk | split: ']]' | first | strip -%}
        {%- assign wa_after = wa_chunk | remove_first: wine_handle | remove_first: ']]' -%}
        {%- assign wp = all_products[wine_handle] -%}
        {%- if wp != empty -%}
          {%- assign wregion = '' -%}{%- assign wgrape = '' -%}
          {%- for wtag in wp.tags -%}
            {%- assign tp = wtag | split: '::' -%}
            {%- if tp[0] == 'secondary' and tp[1] == 'region' -%}{%- assign wregion = tp[2] -%}{%- endif -%}
            {%- if tp[0] == 'secondary' and tp[1] == 'grape' -%}{%- assign wgrape = tp[2] -%}{%- endif -%}
          {%- endfor -%}
          {%- assign weyebrow = '' -%}
          {%- if wregion != blank and wgrape != blank -%}{%- assign weyebrow = wregion | append: ' · ' | append: wgrape -%}
          {%- elsif wregion != blank -%}{%- assign weyebrow = wregion -%}
          {%- elsif wgrape != blank -%}{%- assign weyebrow = wgrape -%}{%- endif -%}
          <div class="wine-card">
            <a class="wine-card__media" href="{{ wp.url }}">{%- if wp.featured_image -%}<img src="{{ wp.featured_image | image_url: width: 300 }}" alt="{{ wp.title | escape }}">{%- endif -%}</a>
            <div class="wine-card__body">
              {%- if weyebrow != blank -%}<div class="wine-card__eyebrow">{{ weyebrow }}</div>{%- endif -%}
              <h3 class="wine-card__title"><a href="{{ wp.url }}">{{ wp.title }}</a></h3>
              {%- if wp.description != blank -%}<p class="wine-card__notes">{{ wp.description | strip_html | truncatewords: 22 }}</p>{%- endif -%}
              <div class="wine-card__foot">
                <span class="wine-card__price">{{ wp.price | money }}</span>
                {%- if wp.available -%}
                  <form action="/cart/add" method="post"><input type="hidden" name="id" value="{{ wp.selected_or_first_available_variant.id }}"><button class="wine-card__btn" type="submit">In den Warenkorb</button></form>
                {%- else -%}
                  <span class="wine-card__btn wine-card__btn--disabled">Ausverkauft</span>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- else -%}
          <p style="color:#c0392b;font-size:14px;">Wein &bdquo;{{ wine_handle }}&ldquo; nicht gefunden.</p>
        {%- endif -%}
        {{ wa_after }}
      {%- endfor -%}
    </div>

    {% if article.tags.size > 0 %}
      <div class="wa-tags">
        {% for tag in article.tags %}
          <a class="wa-tag" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag }}</a>
        {% endfor %}
      </div>
    {% endif %}

    <!-- Footer CTA to the club -->
    <div class="wa-cta">
      <h3>Trink besseren Wein</h3>
      <p>Werde Mitglied im WYNCH Club und starte mit 50 € Guthaben.</p>
      <a class="wa-btn" href="/pages/join">Jetzt Mitglied werden</a>
    </div>

    {% if blog.comments_enabled? %}
      <div class="wa-comments">
        <h3>{{ article.comments_count }} Kommentare</h3>

        {% paginate article.comments by 20 %}
          {% for comment in article.comments %}
            <div class="wa-comment" id="{{ comment.id }}">
              <div>{{ comment.content }}</div>
              <div class="who">{{ comment.author }} &middot; {{ comment.created_at | date: '%d.%m.%Y' }}</div>
            </div>
          {% endfor %}
        {% endpaginate %}

        {% form 'new_comment', article %}
          {% if form.errors %}
            <p style="color:#c0392b;">{{ form.errors | default_errors }}</p>
          {% endif %}
          {% if form.posted_successfully? %}
            <p style="color:var(--accent);">Danke! Dein Kommentar wurde übermittelt.</p>
          {% endif %}
          <div class="wa-form">
            <input type="text" name="comment[author]" placeholder="Dein Name" required>
            <input type="email" name="comment[email]" placeholder="deine@email.de" required>
            <textarea name="comment[body]" placeholder="Dein Kommentar…" required></textarea>
            <button type="submit" class="wa-btn">Kommentar senden</button>
          </div>
        {% endform %}
      </div>
    {% endif %}

  </div>
  </div>
</article>
