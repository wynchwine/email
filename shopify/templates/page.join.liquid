{% layout 'join' %}
<link rel="preconnect" href="https://wynch.wine" crossorigin>
  <link rel="preload" as="font" type="font/woff2" crossorigin
    href="https://wynch.wine/cdn/shop/t/22/assets/giorgio-sans-medium.static.woff2?v=132781297963084722121782491269">
  <link rel="preload" as="font" type="font/woff2" crossorigin
    href="https://wynch.wine/cdn/shop/t/22/assets/aktiv-grotesk-regular.static.woff2?v=138786277528983394311782491269">

  <style>
    @font-face {
      font-family: "Giorgio Sans Medium";
      src: url("https://wynch.wine/cdn/shop/t/22/assets/giorgio-sans-medium.static.woff2?v=132781297963084722121782491269") format("woff2");
      font-weight: 400 700; font-style: normal; font-display: swap;
    }
    @font-face {
      font-family: "Aktiv Grotesk Regular";
      src: url("https://wynch.wine/cdn/shop/t/22/assets/aktiv-grotesk-regular.static.woff2?v=138786277528983394311782491269") format("woff2");
      font-weight: 400; font-style: normal; font-display: swap;
    }

    :root {
      --accent: #ff6315;
      --bg: #eeece7;
      --line: #ff6315;
      --text: #5d5e60;
      --muted: #999999;
      --font-head: "Giorgio Sans Medium", "Futura", "Century Gothic", "Helvetica Neue", Arial, sans-serif;
      --font-body: "Aktiv Grotesk Regular", "Helvetica Neue", Arial, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
    body {
      font-family: var(--font-body);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    /* Framed editorial column */
    .frame {
      max-width: none;
      margin: 40px;
      background: var(--bg);
      border: 1px solid var(--line);
    }
    @media (max-width: 760px) { .frame { margin: 16px; } }

    .divider { border: none; border-top: 1px solid var(--line); }

    .pad { padding-left: 40px; padding-right: 40px; }
    @media (max-width: 520px) { .pad { padding-left: 20px; padding-right: 20px; } }

    /* Logo */
    .logo-row { text-align: center; padding: 18px 20px; }
    .logo-row img { display: inline-block; width: 160px; max-width: 60%; height: auto; }

    /* Hero: two columns on desktop (text+form left, photo flush right) */
    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-areas: "copy media" "form media";
      align-items: center;
    }
    .hero-copy { grid-area: copy; padding: 40px 24px 0 40px; }
    .hero-form { grid-area: form; padding: 8px 24px 44px 40px; }
    .hero-media {
      grid-area: media; align-self: stretch;
      display: flex; align-items: flex-end; justify-content: flex-end;
    }
    .hero-media .hero-photo { max-width: 100%; width: 100%; margin: 0; }
    @media (max-width: 760px) {
      .hero-grid { grid-template-columns: 1fr; grid-template-areas: "copy" "media" "form"; }
      .hero-copy { padding: 30px 20px 8px; text-align: center; }
      .hero-form { padding: 20px 20px 30px; }
      .hero-media { justify-content: center; }
      .hero-media .hero-photo { max-width: 100%; width: 100%; margin: 0; }
    }

    /* Hero */
    .hero { text-align: center; padding-top: 34px; padding-bottom: 30px; }
    h1.hero-head {
      font-family: var(--font-head);
      font-weight: 700;
      color: var(--accent);
      text-transform: uppercase;
      font-size: clamp(54px, 8vw, 68px);
      line-height: 0.98;
      letter-spacing: -0.5px;
    }
    .hero-sub {
      margin: 18px 0 0;
      max-width: 46ch;
      font-size: 17px;
      color: var(--text);
    }
    .hero-ship {
      margin-top: 16px; font-size: 15px; font-weight: 700;
      color: var(--accent); text-transform: uppercase; letter-spacing: 0.5px;
    }
    .hero-form .signup { padding: 0; max-width: none; margin: 0; }
    @media (max-width: 760px) {
      .hero-sub { margin-left: auto; margin-right: auto; }
    }
    .eyebrow {
      font-size: 13px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 14px;
    }

    /* Hero photo (16:9) */
    .media-cell { padding: 0 18px 28px; }
    .hero-photo {
      position: relative;
      width: 100%;
      max-width: 620px;
      margin: 0 auto;
    }
    .hero-photo img { display: block; width: 100%; height: auto; }
    .gift-badge {
      position: absolute; top: -1px; right: -1px; z-index: 2;
      width: 118px; height: 118px; border-radius: 9999px;
      background: var(--accent); color: #fff;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      text-align: center; font-family: var(--font-head); font-weight: 700;
      text-transform: uppercase; font-size: 40px; line-height: 1; letter-spacing: 0.5px;
      transform: rotate(-8deg);
    }
    .gift-badge small { font-family: var(--font-body); font-size: 11px; letter-spacing: 1.5px; margin-top: 6px; opacity: 0.9; }
    @media (max-width: 760px) {
      .gift-badge { width: 100px; height: 100px; font-size: 34px; }
      .gift-badge small { font-size: 9px; margin-top: 4px; }
    }

    /* Signup form */
    .signup { padding: 4px 40px 30px; max-width: 640px; margin: 0 auto; }
    @media (max-width: 520px) { .signup { padding: 4px 20px 26px; } }
    form.email-form { display: flex; gap: 10px; flex-wrap: wrap; }
    .email-form input {
      flex: 1 1 240px; min-width: 0;
      font-family: var(--font-body); font-size: 16px;
      padding: 15px 22px; background: #fff;
      border: 1px solid var(--accent); border-radius: 9999px;
      color: #2c2c2c; outline: none;
    }
    .email-form input.field-full { flex: 1 1 100%; }
    .email-form input::placeholder { color: #a7a49e; }
    .btn {
      flex: 1 1 100%; width: 100%;
      font-family: var(--font-body); font-size: 16px;
      text-transform: uppercase; letter-spacing: 0.5px;
      background: var(--accent); color: var(--bg);
      border: none; border-radius: 9999px;
      padding: 16px 40px; cursor: pointer;
      transition: background 0.15s ease, transform 0.05s ease;
    }
    .btn:hover { background: #e5570f; }
    .btn:active { transform: translateY(1px); }
    .btn:disabled { opacity: 0.55; cursor: default; }
    .form-note { margin-top: 14px; font-size: 15px; min-height: 22px; }
    .form-note.ok { color: var(--accent); }
    .form-note.err { color: var(--accent); font-weight: 700; }
    .fine { margin-top: 14px; font-size: 13px; color: var(--muted); line-height: 1.5; }
    .fine a { color: var(--accent); text-decoration: underline; }

    /* Perks section heading */
    .perks-title {
      text-align: center;
      font-family: var(--font-head); font-weight: 700;
      color: var(--accent); text-transform: uppercase;
      font-size: clamp(40px, 6vw, 56px); line-height: 1.02;
      padding: 46px 40px 6px;
    }
    @media (max-width: 760px) {
      h2.perks-title, h2.about-title { font-size: clamp(54px, 8vw, 68px); }
    }
    .perks-sub {
      text-align: center; padding: 0 40px 8px;
      font-size: 16px; color: var(--muted);
    }

    /* Editorial split rows with icons */
    .split { display: grid; grid-template-columns: 46% 54%; align-items: center; max-width: 940px; margin: 0 auto; }
    .split-left {
      display: flex; align-items: center; gap: 22px;
      padding: 40px 15px 40px 40px;
    }
    .split-icon { flex: 0 0 auto; color: var(--accent); }
    .split-icon svg { width: 60px; height: 60px; display: block; }
    .split-head {
      font-family: var(--font-head); font-weight: 700;
      color: var(--accent); text-transform: uppercase;
      font-size: 34px; line-height: 1.02;
    }
    .split-body { padding: 40px 40px 40px 5px; font-size: 18px; line-height: 1.55; color: var(--text); }
    @media (max-width: 560px) {
      .split { grid-template-columns: 1fr; text-align: center; }
      .split-left { flex-direction: column; gap: 14px; padding: 32px 20px 10px; }
      .split-head { font-size: 40px; }
      .split-icon svg { width: 66px; height: 66px; }
      .split-body { padding: 0 20px 32px; font-size: 19px; }
    }

    /* What is WYNCH */
    .about {
      display: flex; flex-direction: column; align-items: center; text-align: center;
      gap: 28px; padding: 50px 24px 0;
    }
    .about-title {
      font-family: var(--font-head); font-weight: 700;
      color: var(--accent); text-transform: uppercase;
      font-size: clamp(40px, 6vw, 56px); line-height: 1.02; margin-bottom: 16px;
    }
    .about-text { max-width: 560px; }
    .about-text p { font-size: 18px; line-height: 1.6; color: var(--text); }
    .about-media { display: flex; justify-content: center; }
    .about-photo { width: 100%; max-width: 220px; height: auto; display: block; margin: 0 auto; border-radius: 40px 40px 0 0; }
    @media (max-width: 640px) {
      .about { gap: 22px; padding: 34px 16px 0; }
      .about-photo { max-width: 230px; }
    }

    /* Reviews slider */
    .reviews { padding: 8px 40px 48px; }
    @media (max-width: 520px) { .reviews { padding: 8px 16px 40px; } }
    .tslider { max-width: 720px; margin: 0 auto; overflow: hidden; }
    .ttrack { display: flex; transition: transform 0.4s ease; }
    .tcard { flex: 0 0 100%; box-sizing: border-box; padding: 6px 12px 0; text-align: center; }
    .tmark { font-family: Georgia, serif; font-size: 58px; line-height: 0.8; color: var(--accent); margin-bottom: 10px; }
    .tquote { font-size: 22px; line-height: 1.5; color: #3f3f41; min-height: 120px; }
    @media (max-width: 520px) { .tquote { font-size: 19px; min-height: 160px; } }
    .tperson { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 22px; }
    .tavatar {
      width: 54px; height: 54px; border-radius: 9999px; flex: 0 0 auto;
      background: var(--accent); color: #fff;
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-head); font-weight: 700; font-size: 19px;
      box-shadow: inset 0 0 0 2px rgba(255,255,255,0.25);
    }
    /* Distinct, wine-themed colour per reviewer */
    .tcard:nth-child(1) .tavatar { background: radial-gradient(circle at 30% 25%, #9a3a4a, #7b2d3b); }
    .tcard:nth-child(2) .tavatar { background: radial-gradient(circle at 30% 25%, #d76a2a, #c2571f); }
    .tcard:nth-child(3) .tavatar { background: radial-gradient(circle at 30% 25%, #6d7d58, #55643f); }
    .tcard:nth-child(4) .tavatar { background: radial-gradient(circle at 30% 25%, #71487f, #5f3b6b); }
    .tcard:nth-child(5) .tavatar { background: radial-gradient(circle at 30% 25%, #c99a3e, #b8862f); }
    .tname { font-size: 15px; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; }
    .tnav { display: flex; align-items: center; justify-content: center; gap: 16px; margin-top: 26px; }
    .tbtn {
      width: 44px; height: 44px; border-radius: 9999px; flex: 0 0 auto;
      border: 1px solid var(--accent); background: transparent; color: var(--accent);
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      transition: background 0.15s ease, color 0.15s ease;
    }
    .tbtn:hover { background: var(--accent); color: #fff; }
    .tbtn svg { width: 20px; height: 20px; }
    .tdots { display: flex; gap: 9px; }
    .tdot {
      width: 9px; height: 9px; border-radius: 9999px; padding: 0;
      background: transparent; border: 1.5px solid var(--accent); cursor: pointer;
    }
    .tdot.active { background: var(--accent); }

    /* FAQ */
    .faq { padding: 8px 40px 46px; }
    @media (max-width: 520px) { .faq { padding: 8px 20px 40px; } }
    .faq-item { border-bottom: 1px solid var(--line); }
    .faq-item summary {
      list-style: none; cursor: pointer;
      display: flex; justify-content: space-between; align-items: center; gap: 16px;
      padding: 20px 0;
      font-family: var(--font-body); font-weight: 400;
      color: var(--accent); text-transform: uppercase; font-size: 21px; line-height: 1.15;
    }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary::after { content: "+"; font-size: 28px; line-height: 1; color: var(--accent); flex: 0 0 auto; }
    .faq-item[open] summary::after { content: "\2013"; }
    .faq-a { padding: 0 0 22px; font-size: 16px; line-height: 1.6; color: var(--text); max-width: 60ch; }

    /* Footer */
    .foot {
      text-align: center; padding: 20px 18px;
      font-size: 14px; color: #777; line-height: 1.6;
    }
    .foot a.mail { color: var(--accent); text-decoration: underline; }
    .foot .tag { color: #777; }

    /* Step 2 — full-screen post-signup opt-in */
    .step2 {
      position: fixed; inset: 0; z-index: 100;
      background: var(--bg); padding: 40px; text-align: center;
    }
    .step2[hidden] { display: none; }
    .step2-frame {
      width: 100%; height: 100%;
      border: 1px solid var(--line);
      display: flex; align-items: center; justify-content: center;
      padding: 24px;
    }
    @media (max-width: 760px) {
      .step2 { padding: 16px; }
      .step2-yes, .step2-alt { font-size: 19px; padding: 21px; max-width: none; }
    }
    .step2-inner { max-width: 560px; width: 100%; }
    .confetti {
      position: fixed; inset: 0; width: 100vw; height: 100vh;
      pointer-events: none; z-index: 5;
    }
    .confetti svg { width: 100% !important; height: 100% !important; }
    .step2-logo { width: 150px; max-width: 50%; height: auto; margin: 0 auto 28px; display: block; }
    .step2-photo-wrap { position: relative; display: inline-block; margin: 0 auto 30px; }
    .step2-photo { width: min(280px, 72vw); aspect-ratio: 1 / 1; object-fit: cover; border-radius: 28px; display: block; }
    .step2-badge {
      position: absolute; top: -10px; right: -10px;
      width: 88px; height: 88px; border-radius: 9999px;
      background: var(--accent); color: #fff;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      font-family: var(--font-head); font-weight: 700; text-transform: uppercase;
      font-size: 24px; line-height: 1; transform: rotate(-8deg);
    }
    .step2-badge small { font-family: var(--font-body); font-size: 10px; letter-spacing: 1.5px; margin-top: 4px; opacity: 0.9; }
    .step2 h2 {
      font-family: var(--font-head); font-weight: 700;
      color: var(--accent); text-transform: uppercase;
      font-size: clamp(48px, 9vw, 62px); line-height: 1.0; margin-bottom: 18px;
    }
    .step2 p {
      color: var(--text); font-size: 19px; line-height: 1.55;
      margin: 0 auto 32px; max-width: 32ch;
    }
    .step2-deposit {
      margin: 0 auto 30px; max-width: 34ch;
      background: rgba(255, 99, 21, 0.08);
      border: 1px solid rgba(255, 99, 21, 0.35);
      border-radius: 16px; padding: 18px 22px;
      color: var(--text); font-size: 18px; line-height: 1.5;
    }
    .step2-deposit strong { color: var(--accent); font-weight: 700; }
    .step2-actions { display: flex; flex-direction: column; gap: 14px; align-items: center; }
    .step2-yes, .step2-alt {
      width: 100%; max-width: 340px; box-sizing: border-box;
      display: inline-block; text-align: center; text-decoration: none;
      border-radius: 9999px; padding: 18px;
      font-family: var(--font-body); font-size: 17px;
      text-transform: uppercase; letter-spacing: 0.5px; cursor: pointer;
      transition: background 0.15s ease;
    }
    .step2-yes { background: var(--accent); color: #fff; border: none; }
    .step2-yes:hover { background: #e5570f; }
    .step2-alt { background: transparent; color: var(--accent); border: 1px solid var(--accent); }
    .step2-alt:hover { background: rgba(255, 99, 21, 0.10); }
    .step2-no {
      background: transparent; border: none; color: var(--muted);
      font-family: var(--font-body); font-size: 14px; text-decoration: underline;
      cursor: pointer; padding: 6px;
    }
    .step2-no:hover { color: var(--accent); }

    /* Sticky mobile CTA */
    .sticky-cta { display: none; }
    @media (max-width: 760px) {
      .sticky-cta {
        display: block;
        position: fixed; left: 37px; right: 37px; bottom: 20px;
        z-index: 60;
        text-align: center; text-decoration: none;
        background: var(--accent); color: #fff;
        font-family: var(--font-body); font-size: 17px;
        text-transform: uppercase; letter-spacing: 0.5px;
        padding: 17px 20px; border-radius: 9999px;
        transition: opacity 0.2s ease, transform 0.2s ease;
      }
      .sticky-cta.hidden { opacity: 0; transform: translateY(20px); pointer-events: none; }
      body { padding-bottom: 84px; }
    }
  </style>
<div class="frame">

    <!-- Logo -->
    <div class="logo-row">
      <a href="https://wynch.wine" target="_blank" rel="noopener" aria-label="WYNCH">
        <img alt="WYNCH" src="https://wynch.wine/cdn/shop/files/WYNCH_logo_orange_23393be7-386b-4a36-92fb-384933593fcc.png?v=1779214380">
      </a>
    </div>
    <hr class="divider">

    <!-- Hero: text/form left, photo right -->
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 class="hero-head">Join the club,<br>drink better wine.</h1>
        <p class="hero-sub">
          Back independent winemakers, pay fair prices, and start with a
          &euro;50 deposit towards your first wines.
        </p>
        <p class="hero-ship">Delivered anywhere in Germany within 2 days 🇩🇪</p>
      </div>

      <div class="hero-media">
        <figure class="hero-photo">
          <span class="gift-badge">&euro;50<small>to spend</small></span>
          <img src="https://d3k81ch9hvuctc.cloudfront.net/company/XaKdGV/images/85d6738e-5c16-4904-af0d-8237e6994bab.png"
               alt="A hand lifting a bottle of wine above a row of independent-maker bottles">
        </figure>
      </div>

      <div class="hero-form" id="join">
        <div class="signup">
          <form class="email-form" id="signupForm" novalidate>
            <input type="text" id="name" name="name" placeholder="Your name" autocomplete="given-name" required aria-label="Your name">
            <input type="email" id="email" name="email" placeholder="your@email.com" autocomplete="email" required aria-label="Email address">
            <input type="password" id="password" name="password" class="field-full" placeholder="Password" autocomplete="new-password" minlength="8" required aria-label="Password">
            <input type="password" id="password2" name="password2" class="field-full" placeholder="Repeat password" autocomplete="new-password" minlength="8" required aria-label="Repeat password">
            <button type="submit" class="btn" id="submitBtn">Join the club</button>
          </form>
          <div class="form-note" id="formNote" role="status" aria-live="polite"></div>
          <p class="fine">
            By submitting your email you agree to receive marketing emails from WYNCH and accept our
            <a href="https://wynch.wine/policies/terms-of-service" target="_blank" rel="noopener">Terms</a>
            and <a href="https://wynch.wine/policies/privacy-policy" target="_blank" rel="noopener">Privacy&nbsp;Policy</a>.
            Unsubscribe anytime. €50 welcome deposit for new members — terms apply.
          </p>
        </div>
      </div>
    </div>

    <!-- What you get -->
    <hr class="divider">
    <h2 class="perks-title">What you get</h2>
    <p class="perks-sub">Five good reasons to join the club.</p>

    <div class="split">
      <div class="split-left">
        <span class="split-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="6" y="11" width="36" height="26" rx="3"/>
            <line x1="6" y1="19" x2="42" y2="19"/>
            <line x1="12" y1="29" x2="20" y2="29"/>
          </svg>
        </span>
        <div class="split-head">&euro;50 deposit</div>
      </div>
      <div class="split-body">Start with &euro;50 in your account — use it to cover up to 30% of every order you place.</div>
    </div>

    <div class="split">
      <div class="split-left">
        <span class="split-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M39 24a15 15 0 1 1-4.4-10.6"/>
            <path d="M39 9v7h-7"/>
            <circle cx="24" cy="24" r="4.5"/>
          </svg>
        </span>
        <div class="split-head">Cashback</div>
      </div>
      <div class="split-body">Earn cashback on everything you order — it builds up in your account for next time.</div>
    </div>

    <div class="split">
      <div class="split-left">
        <span class="split-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M24 5l15 5v10c0 10-7 16-15 19-8-3-15-9-15-19V10z"/>
            <path d="M17 23l5 5 9-10"/>
          </svg>
        </span>
        <div class="split-head">Love it or refund</div>
      </div>
      <div class="split-body">Don't like a bottle? Send it back and we credit the money straight to your account — no fuss.</div>
    </div>

    <div class="split">
      <div class="split-left">
        <span class="split-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 4h4v11c0 1.5 5 3.5 5 10v14a3 3 0 0 1-3 3h-8a3 3 0 0 1-3-3V25c0-6.5 5-8.5 5-10z"/>
            <line x1="19" y1="31" x2="29" y2="31"/>
          </svg>
        </span>
        <div class="split-head">Exclusive wines</div>
      </div>
      <div class="split-body">Bottles from small, niche wineries you won't find on any supermarket shelf.</div>
