  <!-- Lottie player for the celebration animation -->
  <!-- Native Shopify registration form (carries the required token); filled + submitted from JS -->
  <div id="wynchWrap" style="display:none" aria-hidden="true">
    {% form 'customer_login' %}
      <input type="hidden" name="customer[email]" id="ccEmail">
      <input type="hidden" name="customer[password]" id="ccPassword">
      <input type="hidden" name="return_url" id="ccReturn">
    {% endform %}
  </div>

  <script src="https://unpkg.com/@lottiefiles/lottie-player@2.0.8/dist/lottie-player.js"></script>

  <script>
    // Signup data captured from the form (kept in memory only) + the account
    // creation request kicked off on the opt-in step.
    var API_BASE = 'https://REPLACE-WITH-YOUR-VERCEL-DOMAIN'; // <-- set your Vercel prod URL
    // The Cava photo is hosted on Vercel (public/), not on the Shopify domain,
    // so load it from API_BASE rather than a same-origin path.
    (function () {
      var p = document.getElementById('step2Photo');
      if (p) p.src = API_BASE + '/Bottle_and_wine_glass_202607141610.jpeg';
    })();
    var signupData = null;
    var registerPromise = null;

    // Log the user in via Shopify's native customer_login form (rendered by the
    // Liquid form tag below, so it carries the required token), then redirect.
    function submitLogin(returnPath) {
      var form = document.querySelector('#wynchWrap form');
      if (!signupData || !form) { window.location.href = returnPath; return; }
      document.getElementById('ccEmail').value = signupData.email;
      document.getElementById('ccPassword').value = signupData.password;
      var ret = document.getElementById('ccReturn'); if (ret) ret.value = returnPath;
      form.submit();
    }

    // Wait for the account creation (Admin API) to finish, then log in.
    function loginAndGo(returnPath) {
      if (registerPromise && registerPromise.then) {
        registerPromise.then(function () { submitLogin(returnPath); }, function () { submitLogin(returnPath); });
      } else {
        submitLogin(returnPath);
      }
    }

    // ---- Reviews slider ----
    (function () {
      var track = document.getElementById('tTrack');
      var prev = document.getElementById('tPrev');
      var next = document.getElementById('tNext');
      var dotsWrap = document.getElementById('tDots');
      if (!track || !prev || !next || !dotsWrap) return;

      var count = track.children.length;
      var i = 0;

      var dots = [];
      for (var d = 0; d < count; d++) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'tdot' + (d === 0 ? ' active' : '');
        b.setAttribute('aria-label', 'Go to review ' + (d + 1));
        (function (idx) { b.addEventListener('click', function () { go(idx); }); })(d);
        dotsWrap.appendChild(b);
        dots.push(b);
      }

      function go(n) {
        i = (n + count) % count;
        track.style.transform = 'translateX(' + (-i * 100) + '%)';
        for (var k = 0; k < dots.length; k++) dots[k].classList.toggle('active', k === i);
      }

      prev.addEventListener('click', function () { go(i - 1); });
      next.addEventListener('click', function () { go(i + 1); });
    })();

    // ---- Post-signup opt-in modal ----
    (function () {
      var modal = document.getElementById('step2');
      var inner = document.getElementById('step2Inner');
      var yes = document.getElementById('step2Yes');
      var no = document.getElementById('step2No');
      if (!modal || !inner) return;

      function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;'); }

      // Confetti / party-popper celebration via Lottie.
      var CONFETTI_URL = 'https://assets2.lottiefiles.com/packages/lf20_u4yrau.json';
      function celebrate() {
        var cf = document.createElement('lottie-player');
        cf.className = 'confetti';
        cf.setAttribute('src', CONFETTI_URL);
        cf.setAttribute('autoplay', '');
        cf.setAttribute('background', 'transparent');
        cf.setAttribute('speed', '1');
        cf.setAttribute('preserveAspectRatio', 'xMidYMid slice');
        modal.appendChild(cf);
      }

      function finish(msg) {
        inner.innerHTML =
          '<h2>Welcome to WYNCH</h2>' +
          '<p>' + esc(msg) + '</p>' +
          '<div class="step2-deposit">You now have <strong>&euro;50</strong> in your account &mdash; spend up to <strong>30%</strong> of it on every order.</div>' +
          '<div class="step2-actions">' +
            '<button class="step2-yes" type="button" data-go="/pages/quiz">Take the quiz</button>' +
            '<button class="step2-alt" type="button" data-go="/collections/all-wines">Go to the shop</button>' +
          '</div>';
        inner.querySelectorAll('[data-go]').forEach(function (el) {
          el.addEventListener('click', function () { loginAndGo(el.getAttribute('data-go')); });
        });
        celebrate();
      }

      // Create the Shopify customer (Admin API) + Klaviyo profile. Resolves to
      // { ok, status, error } and is awaited by loginAndGo before logging in.
      function createAccount(marketing) {
        if (!signupData) return Promise.resolve({ ok: false, error: 'no signup data (fill the form first)' });
        var full = (signupData.firstName + ' ' + signupData.lastName).trim();
        return fetch(API_BASE + '/api/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: full,
            email: signupData.email,
            password: signupData.password,
            password2: signupData.password,
            marketing: marketing
          })
        }).then(function (res) {
          return res.json().catch(function () { return {}; }).then(function (d) {
            return { ok: res.ok, status: res.status, error: d.error };
          });
        }).catch(function (e) {
          return { ok: false, error: 'network error (is API_BASE set to your Vercel URL?) ' + (e && e.message ? e.message : '') };
        });
      }

      function handleOptIn(marketing, msg) {
        registerPromise = createAccount(marketing);
        finish(msg);
      }

      if (yes) yes.addEventListener('click', function () {
        handleOptIn(true, "You're all set — your Cava and first picks are on their way to your inbox. 🥂");
      });
      if (no) no.addEventListener('click', function () {
        handleOptIn(false, "No problem — you're in the club. The free Cava is still here if you change your mind.");
      });

      // Open the opt-in screen directly via URL hash (e.g. …/#optin) for preview/sharing.
      function maybeOpen() { if (location.hash === '#optin' || location.hash === '#step2') modal.hidden = false; }
      maybeOpen();
      window.addEventListener('hashchange', maybeOpen);
    })();

    // ---- Sticky mobile CTA ----
    (function () {
      var cta = document.getElementById('stickyCta');
      var joinName = document.getElementById('name');
      var joinBlock = document.getElementById('join');
      if (!cta || !joinBlock) return;

      // Focus the first field after the smooth scroll finishes.
      cta.addEventListener('click', function () {
        setTimeout(function () { if (joinName) joinName.focus({ preventScroll: true }); }, 500);
      });

      // Show the CTA only once the form has scrolled up out of view (past it),
      // not before the user has reached it.
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          var e = entries[0];
          var scrolledPast = !e.isIntersecting && e.boundingClientRect.top < 0;
          cta.classList.toggle('hidden', !scrolledPast);
        }, { threshold: 0 });
        io.observe(joinBlock);
      }
    })();

    // ---- Signup form ----
    (function () {
      var form = document.getElementById('signupForm');
      var input = document.getElementById('email');
      var nameInput = document.getElementById('name');
      var pwInput = document.getElementById('password');
      var pw2Input = document.getElementById('password2');
      var btn = document.getElementById('submitBtn');
      var note = document.getElementById('formNote');
      var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      function setNote(msg, kind) {
        note.textContent = msg;
        note.className = 'form-note ' + (kind || '');
      }

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var name = nameInput.value.trim();
        var email = input.value.trim();
        var pw = pwInput.value;
        var pw2 = pw2Input.value;
        if (!name) { setNote('Please enter your name.', 'err'); nameInput.focus(); return; }
        if (!EMAIL_RE.test(email)) { setNote('Please enter a valid email address.', 'err'); input.focus(); return; }
        if (pw.length < 8) { setNote('Password must be at least 8 characters.', 'err'); pwInput.focus(); return; }
        if (pw !== pw2) { setNote('Passwords do not match.', 'err'); pw2Input.focus(); return; }

        // Keep the credentials in memory so the step-3 buttons can create the
        // Shopify account and log the user in (classic-accounts create_customer).
        var parts = name.split(/\s+/);
        signupData = {
          firstName: parts.shift() || '',
          lastName: parts.join(' '),
          email: email,
          password: pw
        };

        setNote('', '');
        form.reset();
        var step2 = document.getElementById('step2');
        if (step2) step2.hidden = false;
      });
    })();
  </script>
