  <!-- Native Shopify login form (carries the required token); filled + submitted from JS -->
  <div id="wynchWrap" style="display:none" aria-hidden="true">
    {% form 'customer_login' %}
      <input type="hidden" name="customer[email]" id="ccEmail">
      <input type="hidden" name="customer[password]" id="ccPassword">
      <input type="hidden" name="return_url" id="ccReturn">
    {% endform %}
  </div>
</div>

<script src="https://unpkg.com/@lottiefiles/lottie-player@2.0.8/dist/lottie-player.js"></script>
<script>
  // Set this to your Vercel prod URL (serves /api/register + the placeholder photos).
  var API_BASE = 'https://REPLACE-WITH-YOUR-VERCEL-DOMAIN';

  // Hero + step2 photos are hosted on Vercel (public/), not the Shopify domain.
  (function () {
    var h = document.getElementById('heroPhoto');
    if (h) h.src = API_BASE + '/Bottle_and_wine_glass_202607141610.jpeg';
    var p = document.getElementById('step2Photo');
    if (p) p.src = API_BASE + '/Bottle_and_wine_glass_202607141610.jpeg';
  })();

  var signupData = null;      // credentials captured from the form (in memory only)
  var registerPromise = null; // account-creation request kicked off on opt-in

  // ---- UTM: read from URL, persist for the whole visit ----
  function readUrlUtm() {
    try {
      var p = new URLSearchParams(location.search);
      return {
        utm_source: p.get('utm_source') || '',
        utm_medium: p.get('utm_medium') || '',
        utm_campaign: p.get('utm_campaign') || '',
        utm_term: p.get('utm_term') || '',
        utm_content: p.get('utm_content') || ''
      };
    } catch (e) { return { utm_source: '', utm_medium: '', utm_campaign: '', utm_term: '', utm_content: '' }; }
  }
  (function () {
    var u = readUrlUtm();
    if (u.utm_source || u.utm_medium || u.utm_campaign || u.utm_term || u.utm_content) {
      try { localStorage.setItem('wynch_utm', JSON.stringify(u)); } catch (e) { /* ignore */ }
    }
  })();
  function getUtm() {
    var u = readUrlUtm();
    if (u.utm_source || u.utm_medium || u.utm_campaign || u.utm_term || u.utm_content) return u;
    try { var s = localStorage.getItem('wynch_utm'); if (s) return JSON.parse(s); } catch (e) { /* ignore */ }
    return u;
  }

  // ---- Log in via Shopify's native customer_login form (carries the token) ----
  function submitLogin(returnPath) {
    var form = document.querySelector('#wynchWrap form');
    if (!signupData || !form) { window.location.href = returnPath; return; }
    document.getElementById('ccEmail').value = signupData.email;
    document.getElementById('ccPassword').value = signupData.password;
    var ret = document.getElementById('ccReturn'); if (ret) ret.value = returnPath;
    form.submit();
  }
  function loginAndGo(returnPath) {
    if (registerPromise && registerPromise.then) {
      registerPromise.then(function () { submitLogin(returnPath); }, function () { submitLogin(returnPath); });
    } else {
      submitLogin(returnPath);
    }
  }

  // ---- Post-signup opt-in screen ----
  (function () {
    var modal = document.getElementById('step2');
    var inner = document.getElementById('step2Inner');
    var yes = document.getElementById('step2Yes');
    var no = document.getElementById('step2No');
    if (!modal || !inner) return;

    function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;'); }

    var CONFETTI_URL = 'https://assets2.lottiefiles.com/packages/lf20_u4yrau.json';
    function celebrate() {
      var cf = document.createElement('lottie-player');
      cf.className = 'confetti';
      cf.setAttribute('src', CONFETTI_URL);
      cf.setAttribute('autoplay', '');
      cf.setAttribute('background', 'transparent');
      cf.setAttribute('speed', '1');
      cf.setAttribute('preserveAspectRatio', 'xMidYMid slice');
      modal.appendChild(cf);
    }

    function finish(msg, opts) {
      opts = opts || {};
      var confirmHtml = '';
      if (opts.marketing) {
        confirmHtml =
          '<div class="step2-confirm">📩 Deine <strong>kostenlose Cava</strong> ist fast da! Bestätige nur noch deine E-Mail: ' +
          'wir haben einen Link an <strong>' + esc(opts.email || '') + '</strong> geschickt &mdash; ' +
          'öffne dein Postfach (auch den Spam-Ordner) und klick auf den Bestätigungslink.</div>';
      }
      inner.innerHTML =
        '<h2>Willkommen bei WYNCH</h2>' +
        '<p>' + esc(msg) + '</p>' +
        '<div class="step2-deposit">Du hast jetzt <strong>50&nbsp;€</strong> auf deinem Konto &mdash; nutze davon bis zu <strong>30&nbsp;%</strong> bei jeder Bestellung.</div>' +
        confirmHtml +
        '<div class="step2-actions">' +
          '<button class="step2-yes" type="button" data-go="/pages/quiz">Meine Weine finden &mdash; digitaler Sommelier</button>' +
          '<button class="step2-alt" type="button" data-go="/collections/all-wines">Zum Shop</button>' +
        '</div>';
      inner.querySelectorAll('[data-go]').forEach(function (el) {
        el.addEventListener('click', function () { loginAndGo(el.getAttribute('data-go')); });
      });
      celebrate();
    }

    // Create the Shopify customer (Admin API) + Klaviyo profile via /api/register.
    function createAccount(marketing) {
      if (!signupData) return Promise.resolve({ ok: false, error: 'no signup data (fill the form first)' });
      var full = (signupData.firstName + ' ' + signupData.lastName).trim();
      return fetch(API_BASE + '/api/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.assign({
          name: full,
          email: signupData.email,
          password: signupData.password,
          password2: signupData.password,
          marketing: marketing
        }, getUtm()))
      }).then(function (res) {
        return res.json().catch(function () { return {}; }).then(function (d) {
          return { ok: res.ok, status: res.status, error: d.error };
        });
      }).catch(function (e) {
        return { ok: false, error: 'network error (is API_BASE set to your Vercel URL?) ' + (e && e.message ? e.message : '') };
      });
    }

    function handleOptIn(marketing, msg) {
      registerPromise = createAccount(marketing);
      finish(msg, { marketing: marketing, email: signupData && signupData.email });
    }

    if (yes) yes.addEventListener('click', function () {
      handleOptIn(true, "Fast geschafft — nur noch ein Schritt. 🥂");
    });
    if (no) no.addEventListener('click', function () {
      handleOptIn(false, "Kein Problem — du bist im Club. Die kostenlose Cava wartet, falls du es dir anders überlegst.");
    });

    // Open the opt-in screen directly via URL hash (for preview/sharing).
    function maybeOpen() { if (location.hash === '#optin' || location.hash === '#step2') modal.hidden = false; }
    maybeOpen();
    window.addEventListener('hashchange', maybeOpen);
  })();

  // ---- Signup form ----
  (function () {
    var form = document.getElementById('signupForm');
    var nameInput = document.getElementById('name');
    var input = document.getElementById('email');
    var pwInput = document.getElementById('password');
    var pw2Input = document.getElementById('password2');
    var note = document.getElementById('formNote');
    var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!form) return;

    function setNote(msg, kind) {
      if (!note) return;
      note.textContent = msg;
      note.className = 'form-note ' + (kind || '');
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var name = nameInput.value.trim();
      var email = input.value.trim();
      var pw = pwInput.value;
      var pw2 = pw2Input.value;
      if (!name) { setNote('Bitte gib deinen Namen ein.', 'err'); nameInput.focus(); return; }
      if (!EMAIL_RE.test(email)) { setNote('Bitte gib eine gültige E-Mail-Adresse ein.', 'err'); input.focus(); return; }
      if (pw.length < 8) { setNote('Das Passwort muss mindestens 8 Zeichen haben.', 'err'); pwInput.focus(); return; }
      if (pw !== pw2) { setNote('Die Passwörter stimmen nicht überein.', 'err'); pw2Input.focus(); return; }

      var parts = name.split(/\s+/);
      signupData = {
        firstName: parts.shift() || '',
        lastName: parts.join(' '),
        email: email,
        password: pw
      };

      setNote('', '');
      form.reset();
      var step2 = document.getElementById('step2');
      if (step2) step2.hidden = false;
    });
  })();

  // ---- FAQ accordion ----
  document.querySelectorAll('.wynch-landing .faq-q').forEach(function (q) {
    q.addEventListener('click', function () {
      var item = q.closest('.faq-item');
      var open = item.classList.toggle('open');
      item.querySelector('.faq-toggle').textContent = open ? '−' : '+';
    });
  });
</script>
