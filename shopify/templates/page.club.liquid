  <!-- Post-signup opt-in screen -->
  <div class="step2" id="step2" role="dialog" aria-modal="true" aria-labelledby="step2Title" hidden>
    <div class="step2-frame">
      <div class="step2-inner" id="step2Inner">
        <div class="step2-photo-wrap">
