{% layout 'join' %}
{% comment %}
  New WYNCH landing (Figma design) as a Shopify page.
  Uses the standalone "join" layout (layout/join.liquid) — same as page.join.
  Assign this template to a page (e.g. create a page "Club" → template "club" → /pages/club).
  Visual only for now; registration/UTM/Klaviyo logic can be wired in later,
  the same way page.join.liquid does it.
{% endcomment %}

<style>
  @font-face {
    font-family: "Giorgio Sans Medium";
    src: url("https://wynch.wine/cdn/shop/t/22/assets/giorgio-sans-medium.static.woff2?v=132781297963084722121782491269") format("woff2");
    font-weight: 400 700; font-style: normal; font-display: swap;
  }
  @font-face {
    font-family: "Aktiv Grotesk Regular";
    src: url("https://wynch.wine/cdn/shop/t/22/assets/aktiv-grotesk-regular.static.woff2?v=138786277528983394311782491269") format("woff2");
    font-weight: 400; font-style: normal; font-display: swap;
  }

  .wynch-landing {
    --accent: #ff6315;
    --bg: #efece6;
    --ink: #3f3f41;
    --muted: #6f7072;
    --line: #ff6315;
    --font-head: "Giorgio Sans Medium", "Futura", "Century Gothic", "Helvetica Neue", Arial, sans-serif;
    --font-body: "Aktiv Grotesk Regular", "Helvetica Neue", Arial, sans-serif;
    --inset: clamp(20px, 4.5vw, 64px);
    font-family: var(--font-body);
    color: var(--ink);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    background: var(--bg);
    padding: 10px;
  }
  .wynch-landing *, .wynch-landing *::before, .wynch-landing *::after { box-sizing: border-box; }
  .wynch-landing img { max-width: 100%; display: block; }
  .wynch-landing a { color: var(--accent); }

  .wynch-landing .frame {
    border: 1.5px solid var(--accent);
    border-radius: 22px;
    overflow: hidden;
    max-width: 1280px;
    margin: 0 auto;
    background: var(--bg);
  }
  .wynch-landing .divider { border-bottom: 1.5px solid var(--line); }

  .wynch-landing .h-section {
    font-family: var(--font-head);
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-size: clamp(28px, 3.6vw, 40px);
    line-height: 1.02;
    text-align: center;
  }
  .wynch-landing .sub-section { text-align: center; color: var(--muted); font-size: 15px; margin-top: 10px; }
  .wynch-landing .eyebrow {
    font-family: var(--font-head);
    text-transform: uppercase; letter-spacing: 1px; color: var(--accent); font-size: 12px;
  }

  /* Header */
  .wynch-landing .site-head { text-align: center; padding: 16px; }
  .wynch-landing .logo {
    font-family: var(--font-head); color: var(--accent);
    text-transform: uppercase; letter-spacing: 3px; font-size: 22px; font-weight: 700;
  }

  /* Hero */
  .wynch-landing .hero {
    display: grid; grid-template-columns: 1.02fr 1fr;
    gap: clamp(24px, 4vw, 56px); align-items: stretch;
    padding: clamp(28px, 4vw, 52px) var(--inset);
  }
  .wynch-landing .hero-copy { align-self: center; max-width: 460px; }
  .wynch-landing .hero h1 {
    font-family: var(--font-head); color: var(--accent); text-transform: uppercase;
    font-size: clamp(34px, 4.4vw, 54px); line-height: 0.98; letter-spacing: 0.5px;
  }
  .wynch-landing .hero-lead { color: var(--muted); font-size: 16px; margin-top: 16px; max-width: 400px; }
  .wynch-landing .hero .eyebrow { display: block; margin: 26px 0 12px; }

  .wynch-landing .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
  .wynch-landing .field {
    width: 100%; font-family: var(--font-body); font-size: 13px; letter-spacing: 0.4px;
    text-transform: uppercase; color: var(--ink); background: transparent;
    border: 1.5px solid var(--accent); border-radius: 9999px; padding: 14px 20px;
    outline: none; margin-bottom: 12px;
  }
  .wynch-landing .form-row .field { margin-bottom: 0; }
  .wynch-landing .field::placeholder { color: var(--accent); opacity: 0.85; }
  .wynch-landing .field:focus { box-shadow: 0 0 0 2px rgba(255,99,21,0.15); }
  .wynch-landing .btn-primary {
    width: 100%; font-family: var(--font-head); text-transform: uppercase; letter-spacing: 0.6px;
    font-size: 15px; color: #fff; background: var(--accent); border: none; border-radius: 9999px;
    padding: 15px 20px; cursor: pointer; transition: filter 0.15s;
  }
  .wynch-landing .btn-primary:hover { filter: brightness(1.05); }
  .wynch-landing .fineprint { color: var(--muted); font-size: 11.5px; line-height: 1.5; margin-top: 16px; }
  .wynch-landing .form-note { font-size: 13px; margin-top: 8px; min-height: 18px; color: var(--muted); }
  .wynch-landing .form-note.err { color: #c0392b; }

  .wynch-landing .hero-media { position: relative; min-height: 320px; }
  .wynch-landing .hero-media img { width: 100%; height: 100%; object-fit: cover; border-radius: 6px; }
  .wynch-landing .badge {
    position: absolute; top: 14px; left: 14px; width: 92px; height: 92px; border-radius: 50%;
    background: var(--accent); color: #fff; display: flex; flex-direction: column;
    align-items: center; justify-content: center; text-align: center;
    font-family: var(--font-head); line-height: 1; box-shadow: 0 6px 18px rgba(255,99,21,0.3);
  }
  .wynch-landing .badge b { font-size: 26px; }
  .wynch-landing .badge span { font-size: 10px; letter-spacing: 1px; margin-top: 4px; text-transform: uppercase; }

  /* Benefits */
  .wynch-landing .section { padding: clamp(40px, 5vw, 64px) var(--inset); }
  .wynch-landing .benefits-list { max-width: 640px; margin: 40px auto 0; display: flex; flex-direction: column; gap: 30px; }
  .wynch-landing .benefit { display: grid; grid-template-columns: 64px 190px 1fr; gap: 18px; align-items: start; }
  .wynch-landing .benefit .ico { color: var(--accent); }
  .wynch-landing .benefit .ico svg { width: 40px; height: 40px; }
  .wynch-landing .benefit h3 {
    font-family: var(--font-head); text-transform: uppercase; color: var(--ink);
    font-size: 18px; line-height: 1.05; letter-spacing: 0.3px;
  }
  .wynch-landing .benefit p { color: var(--muted); font-size: 15px; }

  /* About / app */
  .wynch-landing .about { text-align: center; }
  .wynch-landing .about-text { max-width: 640px; margin: 18px auto 0; color: var(--muted); font-size: 16px; }
  .wynch-landing .btn-inline {
    display: inline-block; margin-top: 26px; font-family: var(--font-head); text-transform: uppercase;
    letter-spacing: 0.6px; font-size: 14px; color: #fff; background: var(--accent); border: none;
    border-radius: 9999px; padding: 13px 28px; cursor: pointer; text-decoration: none;
  }
  .wynch-landing .app-row { display: flex; align-items: center; justify-content: center; gap: clamp(16px, 4vw, 40px); margin-top: 40px; }
  .wynch-landing .navbtn {
    flex: 0 0 auto; width: 44px; height: 44px; border: 1.5px solid var(--accent); border-radius: 50%;
    background: transparent; color: var(--accent); font-size: 18px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
  }
  .wynch-landing .phone { width: 260px; background: #101012; border-radius: 38px; padding: 10px; box-shadow: 0 20px 45px rgba(0,0,0,0.18); flex: 0 0 auto; }
  .wynch-landing .phone-screen { background: var(--bg); border-radius: 30px; overflow: hidden; position: relative; }
  .wynch-landing .phone-notch { position: absolute; top: 8px; left: 50%; transform: translateX(-50%); width: 90px; height: 20px; background: #101012; border-radius: 12px; z-index: 2; }
  .wynch-landing .app-bar { display: flex; align-items: center; justify-content: space-between; padding: 30px 12px 10px; font-size: 11px; }
  .wynch-landing .app-bar .wm { font-family: var(--font-head); color: var(--accent); letter-spacing: 1px; }
  .wynch-landing .app-pill { background: var(--accent); color: #fff; border-radius: 9999px; padding: 3px 9px; font-family: var(--font-head); font-size: 10px; }
  .wynch-landing .app-cart { border: 1px solid var(--accent); color: var(--accent); border-radius: 50%; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; font-size: 10px; }
  .wynch-landing .app-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; padding: 6px 12px 18px; }
  .wynch-landing .app-card { background: #fff; border-radius: 12px; overflow: hidden; }
  .wynch-landing .app-card .thumb { height: 92px; display: flex; align-items: center; justify-content: center; }
  .wynch-landing .app-card:nth-child(1) .thumb { background: linear-gradient(135deg,#ffd9a0,#ff9d4d); }
  .wynch-landing .app-card:nth-child(2) .thumb { background: linear-gradient(135deg,#ffb36b,#ff7a2f); }
  .wynch-landing .app-card .thumb span { font-size: 34px; }
  .wynch-landing .app-card .meta { padding: 8px; }
  .wynch-landing .match { color: var(--accent); font-family: var(--font-head); font-size: 11px; }
  .wynch-landing .app-card .name { font-size: 9px; color: var(--muted); margin-top: 3px; line-height: 1.3; }
  .wynch-landing .app-card .price { font-family: var(--font-head); font-size: 12px; margin-top: 4px; }

  /* Testimonials */
  .wynch-landing .testi { text-align: center; }
  .wynch-landing .quote-mark { font-family: var(--font-head); color: var(--accent); font-size: 60px; line-height: 0.4; margin-top: 30px; }
  .wynch-landing .quote { max-width: 560px; margin: 18px auto 0; font-size: clamp(18px, 2.2vw, 22px); color: var(--ink); }
  .wynch-landing .who { display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 26px; }
  .wynch-landing .who .ava { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; background: #d9d4cb; }
  .wynch-landing .who .name { font-family: var(--font-head); text-transform: uppercase; letter-spacing: 0.5px; font-size: 12px; color: var(--muted); }
  .wynch-landing .dots { display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 26px; }
  .wynch-landing .dots .navbtn { width: 34px; height: 34px; font-size: 14px; }
  .wynch-landing .dot { width: 8px; height: 8px; border-radius: 50%; background: transparent; border: 1.5px solid var(--accent); }
  .wynch-landing .dot.active { background: var(--accent); }

  /* FAQ */
  .wynch-landing .faq-list { max-width: 900px; margin: 34px auto 0; }
  .wynch-landing .faq-item { border-top: 1px solid rgba(255,99,21,0.5); padding: 20px 0; }
  .wynch-landing .faq-item:last-child { border-bottom: 1px solid rgba(255,99,21,0.5); }
  .wynch-landing .faq-q { display: flex; align-items: center; justify-content: space-between; gap: 16px; cursor: pointer; }
  .wynch-landing .faq-q h3 { font-family: var(--font-head); text-transform: uppercase; letter-spacing: 0.4px; font-size: 15px; color: var(--ink); }
  .wynch-landing .faq-toggle { flex: 0 0 auto; width: 26px; height: 26px; border-radius: 50%; border: 1.5px solid var(--accent); color: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 15px; line-height: 1; }
  .wynch-landing .faq-a { color: var(--muted); font-size: 15px; max-width: 640px; margin-top: 12px; }
  .wynch-landing .faq-item:not(.open) .faq-a { display: none; }

  /* Footer */
  .wynch-landing .site-foot { text-align: center; padding: 30px var(--inset) 34px; }
  .wynch-landing .site-foot p { color: var(--muted); font-size: 13px; }
  .wynch-landing .site-foot .tag { font-family: var(--font-head); text-transform: uppercase; letter-spacing: 0.6px; color: var(--muted); margin-top: 8px; font-size: 12px; }

  @media (max-width: 860px) {
    .wynch-landing .hero { grid-template-columns: 1fr; }
    .wynch-landing .hero-media { min-height: 300px; order: -1; }
    .wynch-landing .benefit { grid-template-columns: 48px 1fr; grid-template-areas: "ico title" "ico desc"; column-gap: 14px; row-gap: 4px; }
    .wynch-landing .benefit .ico { grid-area: ico; }
    .wynch-landing .benefit h3 { grid-area: title; }
    .wynch-landing .benefit p { grid-area: desc; }
    .wynch-landing .app-row { flex-direction: column; }
    .wynch-landing .app-row .navbtn { display: none; }
  }
  @media (max-width: 480px) {
    .wynch-landing .form-row { grid-template-columns: 1fr; }
  }

  /* Step 2 — full-screen post-signup opt-in */
  .wynch-landing .step2 {
    position: fixed; inset: 0; z-index: 100;
    background: var(--bg); padding: 40px; text-align: center;
    overflow-y: auto; -webkit-overflow-scrolling: touch;
    font-family: var(--font-body); color: var(--ink);
  }
  .wynch-landing .step2[hidden] { display: none; }
  .wynch-landing .step2-frame {
    width: 100%; min-height: 100%;
    border: 1px solid var(--line);
    display: flex; align-items: center; justify-content: center; padding: 24px;
  }
  @media (max-width: 760px) {
    .wynch-landing .step2 { padding: 16px; }
    .wynch-landing .step2-yes, .wynch-landing .step2-alt { font-size: 19px; padding: 21px; max-width: none; }
  }
  .wynch-landing .step2-inner { max-width: 560px; width: 100%; }
  .wynch-landing .confetti { position: fixed; inset: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 5; }
  .wynch-landing .confetti svg { width: 100% !important; height: 100% !important; }
  .wynch-landing .step2-photo-wrap { position: relative; display: inline-block; margin: 0 auto 30px; }
  .wynch-landing .step2-photo { width: min(280px, 72vw); aspect-ratio: 1 / 1; object-fit: cover; border-radius: 28px; display: block; }
  .wynch-landing .step2-badge {
    position: absolute; top: -10px; right: -10px; width: 88px; height: 88px; border-radius: 9999px;
    background: var(--accent); color: #fff; display: flex; flex-direction: column;
    align-items: center; justify-content: center; font-family: var(--font-head); font-weight: 700;
    text-transform: uppercase; font-size: 24px; line-height: 1; transform: rotate(-8deg);
  }
  .wynch-landing .step2-badge small { font-family: var(--font-body); font-size: 10px; letter-spacing: 1.5px; margin-top: 4px; opacity: 0.9; }
  .wynch-landing .step2 h2 {
    font-family: var(--font-head); font-weight: 700; color: var(--accent); text-transform: uppercase;
    font-size: clamp(40px, 8vw, 58px); line-height: 1.0; margin-bottom: 18px;
  }
  .wynch-landing .step2 p { color: var(--ink); font-size: 19px; line-height: 1.55; margin: 0 auto 32px; max-width: 32ch; }
  .wynch-landing .step2-deposit {
    margin: 0 auto 30px; max-width: 34ch; background: rgba(255,99,21,0.08);
    border: 1px solid rgba(255,99,21,0.35); border-radius: 16px; padding: 18px 22px;
    color: var(--ink); font-size: 18px; line-height: 1.5;
  }
  .wynch-landing .step2-deposit strong { color: var(--accent); font-weight: 700; }
  .wynch-landing .step2 .step2-confirm {
    margin: 0 auto 30px; max-width: 40ch; background: rgba(255,99,21,0.12);
    border: 1px dashed rgba(255,99,21,0.55); border-radius: 16px; padding: 18px 22px;
    color: var(--ink); font-size: 16px; line-height: 1.55; word-break: break-word;
  }
  .wynch-landing .step2 .step2-confirm strong { color: var(--accent); }
  .wynch-landing .step2-actions { display: flex; flex-direction: column; gap: 14px; align-items: center; }
  .wynch-landing .step2 .step2-legal { margin: 20px auto 0; max-width: 40ch; font-size: 13px; line-height: 1.5; color: var(--muted); }
  .wynch-landing .step2 .step2-legal a { color: var(--accent); text-decoration: underline; }
  .wynch-landing .step2-yes, .wynch-landing .step2-alt {
    width: 100%; max-width: 340px; box-sizing: border-box; display: inline-block; text-align: center;
    text-decoration: none; border-radius: 9999px; padding: 18px; font-family: var(--font-body);
    font-size: 17px; text-transform: uppercase; letter-spacing: 0.5px; cursor: pointer; transition: background 0.15s ease;
  }
  .wynch-landing .step2-yes { background: var(--accent); color: #fff; border: none; }
  .wynch-landing .step2-yes:hover { background: #e5570f; }
  .wynch-landing .step2-alt { background: transparent; color: var(--accent); border: 1px solid var(--accent); }
  .wynch-landing .step2-alt:hover { background: rgba(255,99,21,0.10); }
  .wynch-landing .step2-no {
    background: transparent; border: none; color: var(--muted); font-family: var(--font-body);
    font-size: 14px; text-decoration: underline; cursor: pointer; padding: 6px;
  }
  .wynch-landing .step2-no:hover { color: var(--accent); }
</style>

<div class="wynch-landing">
  <div class="frame">

    <!-- Header -->
    <header class="site-head divider">
      <div class="logo">WYNCH</div>
    </header>

    <!-- Hero -->
    <section class="hero divider">
      <div class="hero-copy">
        <h1>Tritt dem Club bei,<br>trink besseren Wein.</h1>
        <p class="hero-lead">Unterstütze unabhängige Winzer, zahle faire Preise und starte mit 50 € Guthaben für deine ersten Weine.</p>

        <span class="eyebrow">Lieferung deutschlandweit innerhalb von 2 Tagen 🇩🇪</span>

        <form id="signupForm">
          <div class="form-row">
            <input class="field" id="name" type="text" name="name" placeholder="Dein Name" autocomplete="name" required>
            <input class="field" id="email" type="email" name="email" placeholder="deine@email.de" autocomplete="email" required>
          </div>
          <input class="field" id="password" type="password" name="password" placeholder="Passwort" autocomplete="new-password" minlength="8" required>
          <input class="field" id="password2" type="password" name="password2" placeholder="Passwort wiederholen" autocomplete="new-password" minlength="8" required>
          <button class="btn-primary" id="submitBtn" type="submit">Jetzt Mitglied werden</button>
          <p class="form-note" id="formNote"></p>
        </form>

        <p class="fineprint">
          Mit dem Absenden akzeptierst du unsere <a href="/policies/terms-of-service">AGB</a> und <a href="/policies/privacy-policy">Datenschutzerklärung</a>.
          50 € Willkommensguthaben für neue Mitglieder — es gelten die Bedingungen.
        </p>
      </div>

      <div class="hero-media">
        <!-- TODO: replace with the real hero photo (Shopify asset or CDN URL). -->
        <img id="heroPhoto" alt="Weinflaschen auf einem Tisch">
        <div class="badge"><b>50€</b><span>Guthaben</span></div>
      </div>
    </section>

    <!-- Benefits -->
    <section class="section divider">
      <h2 class="h-section">Deine Vorteile</h2>
      <p class="sub-section">Fünf gute Gründe, dem Club beizutreten.</p>

      <div class="benefits-list">
        <div class="benefit">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2.5" y="5.5" width="19" height="13" rx="2.5"/><line x1="2.5" y1="9.5" x2="21.5" y2="9.5"/><line x1="6" y1="14.5" x2="11" y2="14.5"/></svg></div>
          <h3>50€ Guthaben</h3>
          <p>Starte mit 50 € auf deinem Konto — damit bezahlst du bis zu 30 % jeder Bestellung.</p>
        </div>

        <div class="benefit">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M20 12a8 8 0 1 1-2.34-5.66"/><polyline points="20 4 20 7 17 7"/></svg></div>
          <h3>Cashback</h3>
          <p>Sammle Cashback auf jede Bestellung — es landet auf deinem Konto für das nächste Mal.</p>
        </div>

        <div class="benefit">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 2.5 4.5 5.5v6c0 4.6 3.2 8 7.5 9.5 4.3-1.5 7.5-4.9 7.5-9.5v-6L12 2.5Z"/><polyline points="9 12 11.2 14 15 9.5"/></svg></div>
          <h3>Gefällt's nicht,<br>Geld zurück</h3>
          <p>Eine Flasche nicht dein Fall? Schick sie zurück und wir schreiben dir das Geld direkt gut — ganz unkompliziert.</p>
        </div>

        <div class="benefit">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M10 2.5h4M11 2.5v4.2c0 .6-.2 1.1-.6 1.6l-1.6 2c-.5.6-.8 1.4-.8 2.2v7.5c0 .8.7 1.5 1.5 1.5h3c.8 0 1.5-.7 1.5-1.5V14.5c0-.8-.3-1.6-.8-2.2l-1.6-2c-.4-.5-.6-1-.6-1.6V2.5"/><line x1="8.4" y1="13.5" x2="15.6" y2="13.5"/></svg></div>
          <h3>Exklusive Weine</h3>
          <p>Weine von kleinen, besonderen Weingütern, die du in keinem Supermarktregal findest.</p>
        </div>

        <div class="benefit">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="8.5" cy="8" r="3"/><path d="M2.5 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M15.5 5.2A3 3 0 0 1 18 11"/><path d="M17 14.3c2.4.6 4 2.6 4 5.2"/></svg></div>
          <h3>Empfehlen &amp;<br>Profitieren</h3>
          <p>Lade Freunde in den Club ein und erhalte zusätzliches Guthaben, wenn sie ihre erste Bestellung aufgeben.</p>
        </div>
      </div>
    </section>

    <!-- About / app -->
    <section class="section about divider">
      <h2 class="h-section">Was ist WYNCH?</h2>
