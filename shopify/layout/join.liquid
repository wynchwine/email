<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ page_description | default: shop.description | escape }}">
  <title>{{ page_title }}</title>
  <link rel="canonical" href="{{ canonical_url }}">
  {{ content_for_header }}
  <style>*,*::before,*::after{box-sizing:border-box}html,body,h1,h2,h3,h4,p,figure,blockquote,ul,ol,hr,button,input{margin:0;padding:0}</style>
</head>
<body>
  {{ content_for_layout }}
</body>
</html>
